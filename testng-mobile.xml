<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Phone tests. One device runs one test at a time. -->
<suite name="Nova Shop - mobile">
  <listeners>
    <listener class-name="com.practiceqa.novashop.listeners.TestListener"/>
  </listeners>
  <test name="mobile">
    <packages>
      <package name="com.practiceqa.novashop.tests.mobile"/>
    </packages>
  </test>
</suite>
